# PostgreSQL connection string (Neon)
# Récupérer depuis le dashboard Neon : Project > Connection Details
# Format : postgres://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URI=

# Secret pour signer les JWT Payload (auth admin)
# Générer avec : openssl rand -hex 32
PAYLOAD_SECRET=

# Token Vercel Blob (lecture/écriture)
# Récupérer depuis Vercel Dashboard > Storage > Blob > .env.local
BLOB_READ_WRITE_TOKEN=
